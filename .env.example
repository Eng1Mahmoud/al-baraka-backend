# Copy to .env and fill in. Never commit the filled-in file — .gitignore excludes it.

# --- Server ---
PORT=4000
NODE_ENV=development
# Where the storefront runs. Credentialed CORS cannot use "*", so this must be exact.
CORS_ORIGIN=http://localhost:3000

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/al-baraka

# --- Auth (staff only — customers never sign in) ---
# Any long random string. Changing it signs every admin out.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Images (Sirv) ---
# From the Sirv dashboard, Account > Settings > API. SIRV_DOMAIN must match
# NEXT_PUBLIC_SIRV_DOMAIN in the frontend, or next/image refuses to load the files.
SIRV_CLIENT_ID=
SIRV_CLIENT_SECRET=
SIRV_DOMAIN=your-account.sirv.com

# --- Web Push (new-order notifications) ---
# Generate with: npx web-push generate-vapid-keys
# The public key is also served to the browser; the private key never leaves here.
# SUBJECT must be a mailto: or https: URL identifying the sender.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# --- First admin, created by `npm run seed:superadmin` ---
SUPERADMIN_NAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
